#!/bin/sh
# AppRun - the AppImage's entry point.
#
# The image mounts at a different path on every launch, so this script sets
# CDJ3K_RESOURCES from its own location. The binary finds its libraries
# relative to itself through $ORIGIN.
set -eu
HERE="$(dirname "$(readlink -f "$0")")"
export CDJ3K_RESOURCES="${CDJ3K_RESOURCES:-$HERE/opt/cdj3k-emu/share/cdj3k-emu}"
exec "$HERE/opt/cdj3k-emu/bin/cdj3k-emu" "$@"
