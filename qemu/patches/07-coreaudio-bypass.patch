+{
+    return atomic_load_explicit(&g_coreaudio_pipeline_depth_us,
+                                memory_order_relaxed);
+}
+
+/* The device's fixed latency in frames: kAudioDevicePropertyLatency plus
+ * kAudioDevicePropertySafetyOffset, which covers the USB transfer and the
+ * DAC (typically 10-30 ms on a USB interface). It is added to the HAL
+ * depth to give the full host latency. */
