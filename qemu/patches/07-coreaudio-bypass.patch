+ * virtio_snd_bypass_depth_frames read. It leaves the bypass active: a
+ * slightly wrong rate shifts the pitch, while the AUD_write fallback's
+ * resampler glitches on transients. */
+static OSStatus handle_rate_change(AudioObjectID in_object_id,
+                                   UInt32 in_number_addresses,
+                                   const AudioObjectPropertyAddress *in_addresses,
+                                   void *in_client_data)
+{
+    (void)in_number_addresses;
+    (void)in_addresses;
+    (void)in_client_data;
+    coreaudio_refresh_cached_samplerate(in_object_id);
+    return noErr;
+}
