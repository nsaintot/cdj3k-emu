diff --git a/accel/hvf/hvf-accel-ops.c b/accel/hvf/hvf-accel-ops.c
index b74a577..aaa6182 100644
--- a/accel/hvf/hvf-accel-ops.c
+++ b/accel/hvf/hvf-accel-ops.c
@@ -59,6 +59,24 @@
 #include "system/hvf.h"
 #include "system/hvf_int.h"
 #include <mach/mach_time.h>
+#include <pthread.h>
+#include <sys/qos.h>
+
+/* cdj3k-emu: raise HVF vCPU threads to QOS_CLASS_USER_INTERACTIVE.
+ *
+ * A vCPU thread is a normal host thread, even while it runs the guest's
+ * SCHED_FIFO audio thread. When macOS preempts it for tens of
+ * milliseconds, the guest clock pauses and the guest's audio DSP glitches
+ * on resume. USER_INTERACTIVE ranks the thread above default, utility and
+ * background work without a timing contract.
+ *
+ * Do not use THREAD_TIME_CONSTRAINT_POLICY here: vCPU threads spend long
+ * spans in hv_vcpu_run, which breaks the policy's periodic contract, and
+ * macOS throttles them. */
+static void set_vcpu_qos(void)
+{
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+}
 
 HVFState *hvf_state;
 
@@ -160,6 +178,10 @@ static void *hvf_cpu_thread_fn(void *arg)
 
     assert(hvf_enabled());
 
+    /* cdj3k-emu: raise the QoS before the setup below, which holds the
+     * BQL, so that the setup also runs at the higher priority. */
+    set_vcpu_qos();
+
     rcu_register_thread();
 
     bql_lock();
