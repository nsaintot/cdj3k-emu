+#ifdef _WIN32
+/*
+ * cdj3k-emu: how long a halted vCPU polls for work before sleeping on its
+ * condition variable. A Windows wait and wake are a kernel round trip each;
+ * most halts end within the window.
+ */
+#define HALT_SPIN_NS (300 * SCALE_US)
+
+/* Poll, without the BQL, until the vCPU has work or the window closes. */
+static void halt_spin(CPUState *cpu)
+{
+    if (!tcg_enabled() || !cpu_thread_is_idle(cpu)) {
+        return;
+    }
+    int64_t deadline = get_clock() + HALT_SPIN_NS;
+    bql_unlock();
+    while (cpu_thread_is_idle(cpu) && get_clock() < deadline) {
+        YieldProcessor();
+    }
+    bql_lock();
 }
+#endif
 
