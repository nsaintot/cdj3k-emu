+static void *shm_map(const char *path, size_t sz)
+{
+#ifdef _WIN32
+    g_autofree gunichar2 *path_w = g_utf8_to_utf16(path, -1, NULL, NULL, NULL);
+    LARGE_INTEGER cur_size, want_size;
