diff --git a/hw/audio/virtio-snd.c b/hw/audio/virtio-snd.c
index fb5cff3..f1f1853 100644
--- a/hw/audio/virtio-snd.c
+++ b/hw/audio/virtio-snd.c
@@ -36,6 +36,924 @@ static void virtio_snd_process_cmdq(VirtIOSound *s);
 static void virtio_snd_pcm_flush(VirtIOSoundPCMStream *stream);
 static void virtio_snd_pcm_in_cb(void *data, int available);
 static void virtio_snd_unrealize(DeviceState *dev);
+static void virtio_snd_pcm_buffer_free(VirtIOSoundPCMBuffer *buffer);
+
+/* ============= Host audio bypass ring =============
+ * An SPSC ring. virtio-snd's writer thread fills it, and the host backend's
+ * real-time callback drains it: CoreAudio's IOProc on macOS and PipeWire's
+ * process callback on Linux.
+ * The ring skips QEMU's hw->buf_emul and the mixer, which add about
+ * 15-20 ms. It holds stereo F32: S32 input is converted on the way in, and
+ * the writer resamples when the guest and device rates differ. The ring
+ * carries output only.
+ */
+
+/* Declared on every host, so that pcm_close and pcm_prepare can set it
+ * without an #ifdef. The drain timer and the writer start read it. */
+static VirtIOSound *vsnd_drain_target_dev;
+
+/* The ring needs a backend that drains it from its own real-time callback;
+ * elsewhere the stubs below keep every call site unconditional. */
+#if defined(CONFIG_DARWIN) || defined(CONFIG_AUDIO_PIPEWIRE)
+#define VSND_HOST_BYPASS 1
+#endif
+
+#ifdef VSND_HOST_BYPASS
+#include <stdatomic.h>
+#include <pthread.h>
+#include <time.h>
+#include <math.h>
+#ifdef CONFIG_DARWIN
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <mach/thread_policy.h>
+#else
+#include <sched.h>
+#endif
+
+/* cdj3k-emu: give the bypass writer thread a Mach real-time policy, so
+ * normal scheduling jitter cannot delay its 1 ms wake-up; a 5-15 ms delay
+ * drains the ring and the IOProc plays silence.
+ *
+ * The budget is a 2 ms period, 0.5 ms of computation and a 1 ms
+ * constraint; a wake-up does tens of microseconds of work. preemptible=1
+ * lets CoreAudio's HALC_IOThread interrupt the writer. Do not give vCPU
+ * threads this policy: they run for long spans in hv_vcpu_run, and macOS
+ * throttles them. */
+static void vsnd_writer_thread_set_rt(void)
+{
+#ifdef CONFIG_DARWIN
+    mach_timebase_info_data_t tb;
+    if (mach_timebase_info(&tb) != KERN_SUCCESS) {
+        return;
+    }
+    uint64_t period_ns      = 2ULL * 1000 * 1000;
+    uint64_t computation_ns =       500 * 1000;
+    uint64_t constraint_ns  = 1ULL * 1000 * 1000;
+    struct thread_time_constraint_policy ttcpolicy = {
+        .period      = (uint32_t)(period_ns      * tb.denom / tb.numer),
+        .computation = (uint32_t)(computation_ns * tb.denom / tb.numer),
+        .constraint  = (uint32_t)(constraint_ns  * tb.denom / tb.numer),
+        .preemptible = 1,
+    };
+    kern_return_t kr = thread_policy_set(mach_thread_self(),
+                                         THREAD_TIME_CONSTRAINT_POLICY,
+                                         (thread_policy_t)&ttcpolicy,
+                                         THREAD_TIME_CONSTRAINT_POLICY_COUNT);
+    if (kr != KERN_SUCCESS) {
+        fprintf(stderr,
+                "virtio-snd: warning: the writer thread did not get a "
+                "real-time policy (kr=%d); the ring may underrun under host "
+                "load\n",
+                (int)kr);
+    } else {
+        fprintf(stderr,
+                "virtio-snd: writer thread bound to Mach RT (0.5 ms / 2 ms)\n");
+    }
+#else
+    /* Linux has no time-constraint class. SCHED_FIFO works where the
+     * process is allowed it (an rtkit grant, CAP_SYS_NICE, an rtprio
+     * limit); otherwise the writer keeps normal priority and the ring's
+     * depth has to absorb the jitter. */
+    struct sched_param sp = { .sched_priority = 10 };
+    int r = pthread_setschedparam(pthread_self(), SCHED_FIFO, &sp);
+    if (r != 0) {
+        fprintf(stderr,
+                "virtio-snd: writer thread at normal priority "
+                "(SCHED_FIFO refused: %s)\n", strerror(r));
+    } else {
+        fprintf(stderr, "virtio-snd: writer thread bound to SCHED_FIFO 10\n");
+    }
+#endif
+}
+
+/* cdj3k-emu: a dedicated writer thread fills the bypass ring. It polls
+ * every 1 ms and moves stream->queue into the ring without the BQL, so
+ * main-thread stalls do not delay the refill. virtio_snd_handle_tx_xfer
+ * still enqueues under the BQL, guarded by stream->queue_mutex.
+ *
+ * Returning a finished buffer to the guest needs virtqueue_push and
+ * virtio_notify, which need the BQL. The writer therefore adds the buffer
+ * to vsnd_bypass_pending, and vsnd_drain_timer_cb returns it on the main
+ * thread. */
+static atomic_int      vsnd_writer_run;
+static pthread_t       vsnd_writer_thread;
+static bool            vsnd_writer_started;
+static pthread_mutex_t vsnd_bypass_pending_mutex = PTHREAD_MUTEX_INITIALIZER;
+static _Atomic(VirtIOSound *) vsnd_writer_target;
+
+/* Guest's negotiated PCM rate (e.g. 44100 or 96000). Stored on bypass
+ * activation; the resampler in vsnd_bypass_write_resampled() pairs this
+ * with the live HAL rate to compute the conversion ratio. */
+static _Atomic uint32_t vsnd_bypass_guest_rate;
+
+/* Cubic Hermite (Catmull-Rom) resampler state. Only the writer thread
+ * changes it, so it needs no lock. It persists across buffers, so the
+ * resampler keeps its phase from one guest buffer to the next, and it is
+ * cleared only on a cold bypass activation (a format change).
+ *
+ * Cubic Hermite with Catmull-Rom tangents is C1-continuous. Linear
+ * interpolation is only C0-continuous, and its slope jumps alias into the
+ * audible band when the output rate is below twice the input rate. */
+typedef struct {
+    /* Sliding window of the last four input frames (per channel),
+     * oldest at index 0, newest at index 3. The current output segment
+     * lies between y[1] and y[2]; y[0] supplies the left tangent
+     * neighbor and y[3] the right tangent neighbor. */
+    float  y[4][2];   /* [time index 0..3][channel: 0=L, 1=R] */
+    double frac;      /* [0, 1): fractional output position within segment [y[1], y[2]] */
+
+    /* The state of the 2nd-order Butterworth lowpass that filters
+     * aliases before downsampling. Direct Form II Transposed needs two
+     * state variables per channel. A cold start clears them with the
+     * rest of the struct. */
+    float  biq_s1[2]; /* [channel 0=L, 1=R] */
+    float  biq_s2[2];
+} VsndResamplerState;
+static VsndResamplerState vsnd_resampler;
+
+/* Clock-skew correction on the resampled path.
+ *
+ * When the device clock runs slightly slower than the guest's rate, the
+ * writer outpaces the reader and the ring fills. A soft PLL corrects this:
+ * each call compares the ring depth with a target and adjusts the
+ * resampler ratio by at most ±VSND_PLL_MAX_CORRECTION (0.5%), which is not
+ * audible. Do not drop frames instead: a drop that lands on a transient
+ * clicks.
+ *
+ * The target is in milliseconds and is converted to bytes at the current
+ * HAL rate on each call. 80 ms stays below the guest's watchdog (~100 ms)
+ * with headroom for host jitter. */
+#define VSND_BYPASS_HIGH_WATER_MS 80
+/* The integrator step per write call, applied to the normalized depth
+ * error. At about 100 writer calls per second, a 100% error moves the
+ * integrator by 1e-4 per second, so it reaches the ±0.5% clamp after
+ * about 50 s of error in one direction. That is slow enough to ignore the
+ * short-term depth swings of the writer/reader cadence, which a
+ * proportional term turns into audible pitch modulation, and fast enough
+ * to follow real clock drift before the ring fills or empties. */
+#define VSND_PLL_INTEGRATOR_STEP  1.0e-6
+#define VSND_PLL_MAX_CORRECTION   0.005   /* the largest correction, ±0.5% */
+
+/* The accumulated PLL ratio correction. Only the writer thread changes
+ * it. It is reset only on a cold bypass activation, so it survives the PCM
+ * prepare that follows each guest watchdog xrun. */
+static double vsnd_pll_integrator;
+
+size_t virtio_snd_bypass_read(void *dst, size_t bytes);
+size_t virtio_snd_bypass_avail(void);
+int    virtio_snd_bypass_is_active(void);
+
+/* SPSC ring between the writer thread and the host backend's real-time
+ * callback. 128 KB holds about 170 ms of 96 kHz stereo F32 (8 bytes per
+ * frame) and absorbs HAL jitter and preemption of the writer. */
+#define VSND_BYPASS_BYTES (128 * 1024)
+static uint8_t  vsnd_bypass_ring[VSND_BYPASS_BYTES];
+static _Atomic uint64_t vsnd_bypass_head;   /* writer (vsnd_writer_thread_fn) */
+static _Atomic uint64_t vsnd_bypass_tail;   /* reader (the host backend's callback) */
+static _Atomic int      vsnd_bypass_active;
+static int              vsnd_bypass_src_fmt; /* AUDIO_FORMAT_F32 or _S32 */
+static _Atomic uint64_t vsnd_bypass_underrun_frames;
+static _Atomic uint64_t vsnd_bypass_overrun_count;
+
+size_t virtio_snd_bypass_read(void *dst, size_t bytes)
+{
+    uint64_t t = atomic_load_explicit(&vsnd_bypass_tail, memory_order_relaxed);
+    uint64_t h = atomic_load_explicit(&vsnd_bypass_head, memory_order_acquire);
+    uint64_t avail = h - t;
+    if (bytes > avail) bytes = avail;
+    uint32_t off = (uint32_t)(t & (VSND_BYPASS_BYTES - 1));
+    size_t first = MIN(bytes, VSND_BYPASS_BYTES - off);
+    memcpy(dst, vsnd_bypass_ring + off, first);
+    if (bytes > first) {
+        memcpy((uint8_t *)dst + first, vsnd_bypass_ring, bytes - first);
+    }
+    atomic_store_explicit(&vsnd_bypass_tail, t + bytes, memory_order_release);
+    return bytes;
+}
+
+size_t virtio_snd_bypass_avail(void)
+{
+    uint64_t t = atomic_load_explicit(&vsnd_bypass_tail, memory_order_relaxed);
+    uint64_t h = atomic_load_explicit(&vsnd_bypass_head, memory_order_acquire);
+    return (size_t)(h - t);
+}
+
+/* Record an underrun: the host callback found the ring empty and played
+ * `frames` frames of silence. It runs on the real-time audio thread, so
+ * it must not take a lock. */
+void virtio_snd_bypass_note_underrun(uint32_t frames);
+void virtio_snd_bypass_note_underrun(uint32_t frames)
+{
+    atomic_fetch_add_explicit(&vsnd_bypass_underrun_frames,
+                              (uint64_t)frames,
+                              memory_order_relaxed);
+}
+
+/* Return the cumulative underrun frame count without resetting it, so
+ * that a periodic logger can compute deltas. */
+uint64_t virtio_snd_bypass_underrun_total_frames(void);
+uint64_t virtio_snd_bypass_underrun_total_frames(void)
+{
+    return atomic_load_explicit(&vsnd_bypass_underrun_frames,
+                                memory_order_relaxed);
+}
+
+/* Return the cumulative overrun count: how many times the writer found
+ * the ring full. A rising count means that the writer is faster than the
+ * reader, typically because of a rate mismatch. */
+uint64_t virtio_snd_bypass_overrun_total(void);
+uint64_t virtio_snd_bypass_overrun_total(void)
+{
+    return atomic_load_explicit(&vsnd_bypass_overrun_count,
+                                memory_order_relaxed);
+}
+
+/* What the host backend reports about the pipeline downstream of the ring. */
+#ifdef CONFIG_DARWIN
+extern uint32_t coreaudio_get_pipeline_depth_us(void);
+extern uint32_t coreaudio_get_static_latency_frames(void);
+extern unsigned coreaudio_get_active_samplerate(void);
+#define host_audio_pipeline_depth_us     coreaudio_get_pipeline_depth_us
+#define host_audio_static_latency_frames coreaudio_get_static_latency_frames
+#define host_audio_active_samplerate     coreaudio_get_active_samplerate
+#else
+extern uint32_t pwaudio_get_pipeline_depth_us(void);
+extern uint32_t pwaudio_get_static_latency_frames(void);
+extern unsigned pwaudio_get_active_samplerate(void);
+#define host_audio_pipeline_depth_us     pwaudio_get_pipeline_depth_us
+#define host_audio_static_latency_frames pwaudio_get_static_latency_frames
+#define host_audio_active_samplerate     pwaudio_get_active_samplerate
+#endif
+
+/* The host pipeline depth after the bypass ring: the backend's queue plus
+ * the device's fixed latency. It leaves out the ring itself, which the
+ * guest already counts in frames_in_flight. */
+uint32_t virtio_snd_bypass_depth_frames(void);
+uint32_t virtio_snd_bypass_depth_frames(void)
+{
+    uint32_t hal_us = host_audio_pipeline_depth_us();
+    uint32_t hal_rate = host_audio_active_samplerate();
+    uint32_t hal_frames = 0;
+    if (hal_rate > 0)
+        hal_frames = (uint32_t)(((uint64_t)hal_us * hal_rate) / 1000000ULL);
+    uint32_t static_frames = host_audio_static_latency_frames();
+    return hal_frames + static_frames;
+}
+
+int virtio_snd_bypass_is_active(void)
+{
+    return atomic_load_explicit(&vsnd_bypass_active, memory_order_acquire);
+}
+
+static uint64_t vsnd_bypass_head_value(void)
+{
+    return atomic_load_explicit(&vsnd_bypass_head, memory_order_relaxed);
+}
+
+/* The passthrough path, used when the rates match or the HAL rate is
+ * unknown. It converts the input to F32 frame for frame and writes it to
+ * the ring. It returns src_bytes, or 0 when the ring is full; the caller
+ * then leaves the buffer in the queue. */
+static size_t vsnd_bypass_write_passthrough(const void *src, size_t src_bytes)
+{
+    uint64_t h = atomic_load_explicit(&vsnd_bypass_head, memory_order_relaxed);
+    uint64_t t = atomic_load_explicit(&vsnd_bypass_tail, memory_order_acquire);
+    uint64_t free = VSND_BYPASS_BYTES - (h - t);
+    if (src_bytes > free) {
+        atomic_fetch_add_explicit(&vsnd_bypass_overrun_count, 1,
+                                  memory_order_relaxed);
+        return 0;
+    }
+    uint32_t off = (uint32_t)(h & (VSND_BYPASS_BYTES - 1));
+    if (vsnd_bypass_src_fmt == AUDIO_FORMAT_F32) {
+        size_t first = MIN(src_bytes, VSND_BYPASS_BYTES - off);
+        memcpy(vsnd_bypass_ring + off, src, first);
+        if (src_bytes > first) {
+            memcpy(vsnd_bypass_ring, (const uint8_t *)src + first,
+                   src_bytes - first);
+        }
+    } else {
+        const int32_t *s = src;
+        size_t n = src_bytes / 4;
+        const float scale = 1.0f / 2147483648.0f;
+        for (size_t i = 0; i < n; i++) {
+            float f = (float)s[i] * scale;
+            uint32_t fb;
+            memcpy(&fb, &f, 4);
+            uint32_t pos = (off + (uint32_t)(i * 4)) &
+                           (VSND_BYPASS_BYTES - 1);
+            memcpy(vsnd_bypass_ring + pos, &fb, 4);
+        }
+    }
+    atomic_store_explicit(&vsnd_bypass_head, h + src_bytes,
+                          memory_order_release);
+    return src_bytes;
+}
+
+/* The resampled path: cubic Hermite (Catmull-Rom) interpolation from
+ * in_rate to out_rate, from S32 or F32 input to F32 output. It runs on the
+ * writer thread and changes vsnd_resampler without a lock.
+ *
+ * Cubic Hermite formula for output at fractional position t in [0, 1)
+ * within segment [y1, y2], using Catmull-Rom tangents from y0 and y3:
+ *
+ *   m1 = (y2 - y0) / 2
+ *   m2 = (y3 - y1) / 2
+ *   out = (2t³ - 3t² + 1) y1 + (t³ - 2t² + t) m1
+ *       + (-2t³ + 3t²)    y2 + (t³ - t²)       m2
+ *
+ * Each channel keeps a sliding window of four samples. Each input frame
+ * shifts the window left and enters on the right; the loop then emits zero
+ * or more output frames for segment [y1, y2] while frac < 1, and
+ * `frac -= 1` starts the next segment.
+ *
+ * Clock skew: each call adjusts the resampler ratio through the integrator
+ * PLL below, so the ring stays near its target depth without dropping
+ * frames.
+ *
+ * The ring space reserved up front is the worst-case output:
+ *   ceil(in_frames * out_rate / in_rate) + 2 frames
+ * where the 2 extra frames cover the rollover of the fractional phase. */
+static size_t vsnd_bypass_write_resampled(const void *src, size_t src_bytes,
+                                          uint32_t in_rate, uint32_t out_rate)
+{
+    /* Both S32 stereo and F32 stereo are 8 bytes/frame. */
+    size_t in_frames = src_bytes / 8;
+    if (in_frames == 0 || in_rate == 0 || out_rate == 0) {
+        return 0;
+    }
+
+    size_t max_out_frames =
+        (size_t)(((uint64_t)in_frames * out_rate + (in_rate - 1)) / in_rate) + 2;
+    size_t max_out_bytes = max_out_frames * 8;
+
+    uint64_t h = atomic_load_explicit(&vsnd_bypass_head, memory_order_relaxed);
+    uint64_t t = atomic_load_explicit(&vsnd_bypass_tail, memory_order_acquire);
+    uint64_t depth = h - t;
+    uint64_t free = VSND_BYPASS_BYTES - depth;
+    if (max_out_bytes > free) {
+        atomic_fetch_add_explicit(&vsnd_bypass_overrun_count, 1,
+                                  memory_order_relaxed);
+        return 0;
+    }
+
+    /* Integrator-only PLL for clock-skew correction. A proportional term
+     * follows the natural depth swings of the writer/reader cadence (about
+     * 4 KB writes and 2 KB reads) and modulates the pitch. The integrator
+     * converges in seconds and then holds steady.
+     *
+     * A positive integrator means that the ring is above its target: the
+     * ratio grows, so the resampler produces fewer output frames per
+     * input frame and the ring drains. */
+    int64_t target_bytes =
+        (int64_t)(((uint64_t)out_rate * 8 * VSND_BYPASS_HIGH_WATER_MS) / 1000);
+    int64_t err_bytes = (int64_t)depth - target_bytes;
+    double  err_norm  = target_bytes > 0
+                            ? (double)err_bytes / (double)target_bytes
+                            : 0.0;
+    vsnd_pll_integrator += err_norm * VSND_PLL_INTEGRATOR_STEP;
+    if (vsnd_pll_integrator >  VSND_PLL_MAX_CORRECTION) {
+        vsnd_pll_integrator =  VSND_PLL_MAX_CORRECTION;
+    }
+    if (vsnd_pll_integrator < -VSND_PLL_MAX_CORRECTION) {
+        vsnd_pll_integrator = -VSND_PLL_MAX_CORRECTION;
+    }
+
+    const bool   is_s32        = (vsnd_bypass_src_fmt == AUDIO_FORMAT_S32);
+    const float  scale         = 1.0f / 2147483648.0f;
+    const double nominal_ratio = (double)in_rate / (double)out_rate;
+    const double ratio         = nominal_ratio * (1.0 + vsnd_pll_integrator);
+
+    /* Anti-alias filter for downsampling (in_rate > out_rate). Without
+     * it, content between out_rate/2 and in_rate/2 folds into the audible
+     * band. A 2nd-order Butterworth lowpass at 0.46 × out_rate (-12 dB per
+     * octave above the cutoff) removes most of it. It is a Direct Form II
+     * Transposed biquad with its state in vsnd_resampler. The coefficients
+     * are recomputed on every call. */
+    bool  downsample = (in_rate > out_rate);
+    float b0 = 0, b1 = 0, b2 = 0, a1 = 0, a2 = 0;
+    if (downsample) {
+        double fc = 0.46 * (double)out_rate;
+        double w0 = 2.0 * M_PI * fc / (double)in_rate;
+        double cos_w0 = cos(w0);
+        double sin_w0 = sin(w0);
+        double Q = 0.70710678; /* Butterworth */
+        double alpha = sin_w0 / (2.0 * Q);
+        double a0 = 1.0 + alpha;
+        b0 = (float)((1.0 - cos_w0) * 0.5 / a0);
+        b1 = (float)((1.0 - cos_w0)        / a0);
+        b2 = b0;
+        a1 = (float)(-2.0 * cos_w0         / a0);
+        a2 = (float)((1.0 - alpha)         / a0);
+    }
+    /* Copy the biquad state into locals, so that the loop keeps it in
+     * registers; it is saved back at the end. */
+    float biq_s1_L = vsnd_resampler.biq_s1[0];
+    float biq_s2_L = vsnd_resampler.biq_s2[0];
+    float biq_s1_R = vsnd_resampler.biq_s1[1];
+    float biq_s2_R = vsnd_resampler.biq_s2[1];
+
+    /* Copy the sliding window into locals as well. */
+    float y0_L = vsnd_resampler.y[0][0], y1_L = vsnd_resampler.y[1][0],
+          y2_L = vsnd_resampler.y[2][0], y3_L = vsnd_resampler.y[3][0];
+    float y0_R = vsnd_resampler.y[0][1], y1_R = vsnd_resampler.y[1][1],
+          y2_R = vsnd_resampler.y[2][1], y3_R = vsnd_resampler.y[3][1];
+    double frac = vsnd_resampler.frac;
+
+    size_t out_bytes = 0;
+
+    for (size_t i = 0; i < in_frames; i++) {
+        /* Read the next input frame in either source format. */
+        float new_L, new_R;
+        if (is_s32) {
+            const int32_t *isrc = (const int32_t *)src;
+            new_L = (float)isrc[i * 2]     * scale;
+            new_R = (float)isrc[i * 2 + 1] * scale;
+        } else {
+            const float *fsrc = (const float *)src;
+            new_L = fsrc[i * 2];
+            new_R = fsrc[i * 2 + 1];
+        }
+
+        /* Apply the anti-alias lowpass before the resampler sees the
+         * sample (Direct Form II Transposed):
+         *   y  = b0*x + s1
+         *   s1 = b1*x - a1*y + s2
+         *   s2 = b2*x - a2*y                                       */
+        if (downsample) {
+            float y_L = b0 * new_L + biq_s1_L;
+            biq_s1_L  = b1 * new_L - a1 * y_L + biq_s2_L;
+            biq_s2_L  = b2 * new_L - a2 * y_L;
+            new_L = y_L;
+
+            float y_R = b0 * new_R + biq_s1_R;
+            biq_s1_R  = b1 * new_R - a1 * y_R + biq_s2_R;
+            biq_s2_R  = b2 * new_R - a2 * y_R;
+            new_R = y_R;
+        }
+
+        /* Shift the window: the oldest sample leaves on the left and the
+         * new one enters on the right. The output segment [y1, y2] then
+         * sits behind the newest input, which gives one input of
+         * lookahead for the right tangent. */
+        y0_L = y1_L; y1_L = y2_L; y2_L = y3_L; y3_L = new_L;
+        y0_R = y1_R; y1_R = y2_R; y2_R = y3_R; y3_R = new_R;
+
+        /* Emit zero or more output frames for segment [y1, y2].
+         * Downsampling can emit none for several input frames, and strong
+         * upsampling emits several per input frame. */
+        while (frac < 1.0) {
+            float t_f = (float)frac;
+            float t2  = t_f * t_f;
+            float t3  = t2  * t_f;
+
+            float m1_L = 0.5f * (y2_L - y0_L);
+            float m2_L = 0.5f * (y3_L - y1_L);
+            float m1_R = 0.5f * (y2_R - y0_R);
+            float m2_R = 0.5f * (y3_R - y1_R);
+
+            float h00 = 2.0f * t3 - 3.0f * t2 + 1.0f;
+            float h10 = t3 - 2.0f * t2 + t_f;
+            float h01 = -2.0f * t3 + 3.0f * t2;
+            float h11 = t3 - t2;
+
+            float out_L = h00 * y1_L + h10 * m1_L + h01 * y2_L + h11 * m2_L;
+            float out_R = h00 * y1_R + h10 * m1_R + h01 * y2_R + h11 * m2_R;
+
+            /* L and R each get their own masked position, so a frame can
+             * straddle the end of the ring. */
+            uint32_t pos_L = (uint32_t)((h + out_bytes) &
+                                        (VSND_BYPASS_BYTES - 1));
+            uint32_t pos_R = (uint32_t)((h + out_bytes + 4) &
+                                        (VSND_BYPASS_BYTES - 1));
+            memcpy(vsnd_bypass_ring + pos_L, &out_L, 4);
+            memcpy(vsnd_bypass_ring + pos_R, &out_R, 4);
+            out_bytes += 8;
+            if (out_bytes + 8 > max_out_bytes) {
+                /* max_out_frames should make this unreachable; stop at
+                 * the reserved size if it is reached anyway. */
+                goto done;
+            }
+            frac += ratio;
+        }
+
+        frac -= 1.0;
+    }
+
+done:
+    vsnd_resampler.y[0][0] = y0_L; vsnd_resampler.y[1][0] = y1_L;
+    vsnd_resampler.y[2][0] = y2_L; vsnd_resampler.y[3][0] = y3_L;
+    vsnd_resampler.y[0][1] = y0_R; vsnd_resampler.y[1][1] = y1_R;
+    vsnd_resampler.y[2][1] = y2_R; vsnd_resampler.y[3][1] = y3_R;
+    vsnd_resampler.frac    = frac;
+    vsnd_resampler.biq_s1[0] = biq_s1_L; vsnd_resampler.biq_s2[0] = biq_s2_L;
+    vsnd_resampler.biq_s1[1] = biq_s1_R; vsnd_resampler.biq_s2[1] = biq_s2_R;
+
+    atomic_store_explicit(&vsnd_bypass_head, h + out_bytes,
+                          memory_order_release);
+    return out_bytes;
+}
+
+/* Write one buffer to the ring through the passthrough or the resampled
+ * path, chosen from the HAL rate and the guest's rate. Both are atomics,
+ * so the call takes no lock. The write is all or nothing: it returns 0
+ * when the ring is full, and the caller leaves the buffer in
+ * stream->queue to retry. */
+static size_t vsnd_bypass_write_convert(const void *src, size_t src_bytes)
+{
+    uint32_t hal_rate   = host_audio_active_samplerate();
+    uint32_t guest_rate = atomic_load_explicit(&vsnd_bypass_guest_rate,
+                                               memory_order_relaxed);
+    if (hal_rate == 0 || guest_rate == 0 || hal_rate == guest_rate) {
+        /* The rates match, or the HAL rate is not known yet. In the
+         * second case passthrough may play at the wrong pitch, but it
+         * does not play silence. */
+        return vsnd_bypass_write_passthrough(src, src_bytes);
+    }
+    return vsnd_bypass_write_resampled(src, src_bytes, guest_rate, hal_rate);
+}
+
+/* Deferred return of TX buffers: each write records the ring position
+ * after the buffer (end_head), and the buffer goes back to the guest once
+ * the reader's tail reaches end_head. */
+typedef struct VsndBypassPending {
+    VirtIOSoundPCMBuffer  *buf;
+    VirtIOSoundPCMStream  *stream;
+    uint64_t               end_head;
+    QSIMPLEQ_ENTRY(VsndBypassPending) entry;
+} VsndBypassPending;
+static QSIMPLEQ_HEAD(VsndBypassPendingHead, VsndBypassPending) vsnd_bypass_pending =
+    QSIMPLEQ_HEAD_INITIALIZER(vsnd_bypass_pending);
+
+static void vsnd_bypass_release_buf(VirtIOSoundPCMStream *stream,
+                                    VirtIOSoundPCMBuffer *buffer)
+{
+    virtio_snd_pcm_status resp = { 0 };
+    resp.status = cpu_to_le32(VIRTIO_SND_S_OK);
+    resp.latency_bytes = cpu_to_le32((uint32_t)buffer->size);
+    iov_from_buf(buffer->elem->in_sg, buffer->elem->in_num, 0,
+                 &resp, sizeof(virtio_snd_pcm_status));
+    virtqueue_push(buffer->vq, buffer->elem,
+                   sizeof(virtio_snd_pcm_status));
+    virtio_notify(VIRTIO_DEVICE(stream->s), buffer->vq);
+    virtio_snd_pcm_buffer_free(buffer);
+}
+
+/* Add a buffer to the pending list. The writer thread (off the BQL) and
+ * the main thread's flush both call this; the mutex serializes them. */
+static void vsnd_bypass_pending_push(VirtIOSoundPCMStream *s,
+                                     VirtIOSoundPCMBuffer *b,
+                                     uint64_t end_head)
+{
+    VsndBypassPending *p = g_new0(VsndBypassPending, 1);
+    p->buf = b;
+    p->stream = s;
+    p->end_head = end_head;
+    pthread_mutex_lock(&vsnd_bypass_pending_mutex);
+    QSIMPLEQ_INSERT_TAIL(&vsnd_bypass_pending, p, entry);
+    pthread_mutex_unlock(&vsnd_bypass_pending_mutex);
+}
+
+/* Return the pending buffers whose audio the reader has consumed. The
+ * main thread calls this from the drain timer and from flush. Each release
+ * calls virtio_notify, which needs the BQL, so this runs under the BQL:
+ * it moves the entries to a local list under the mutex and releases them
+ * after the mutex is dropped. */
+static void vsnd_bypass_pending_drain(void)
+{
+    uint64_t t = atomic_load_explicit(&vsnd_bypass_tail, memory_order_acquire);
+    QSIMPLEQ_HEAD(, VsndBypassPending) local = QSIMPLEQ_HEAD_INITIALIZER(local);
+
+    pthread_mutex_lock(&vsnd_bypass_pending_mutex);
+    while (!QSIMPLEQ_EMPTY(&vsnd_bypass_pending)) {
+        VsndBypassPending *p = QSIMPLEQ_FIRST(&vsnd_bypass_pending);
+        if (p->end_head > t) {
+            break;
+        }
+        QSIMPLEQ_REMOVE_HEAD(&vsnd_bypass_pending, entry);
+        QSIMPLEQ_INSERT_TAIL(&local, p, entry);
+    }
+    pthread_mutex_unlock(&vsnd_bypass_pending_mutex);
+
+    while (!QSIMPLEQ_EMPTY(&local)) {
+        VsndBypassPending *p = QSIMPLEQ_FIRST(&local);
+        QSIMPLEQ_REMOVE_HEAD(&local, entry);
+        vsnd_bypass_release_buf(p->stream, p->buf);
+        g_free(p);
+    }
+}
+
+static void vsnd_bypass_pending_flush(void)
+{
+    QSIMPLEQ_HEAD(, VsndBypassPending) local = QSIMPLEQ_HEAD_INITIALIZER(local);
+
+    pthread_mutex_lock(&vsnd_bypass_pending_mutex);
+    while (!QSIMPLEQ_EMPTY(&vsnd_bypass_pending)) {
+        VsndBypassPending *p = QSIMPLEQ_FIRST(&vsnd_bypass_pending);
+        QSIMPLEQ_REMOVE_HEAD(&vsnd_bypass_pending, entry);
+        QSIMPLEQ_INSERT_TAIL(&local, p, entry);
+    }
+    pthread_mutex_unlock(&vsnd_bypass_pending_mutex);
+
+    while (!QSIMPLEQ_EMPTY(&local)) {
+        VsndBypassPending *p = QSIMPLEQ_FIRST(&local);
+        QSIMPLEQ_REMOVE_HEAD(&local, entry);
+        vsnd_bypass_release_buf(p->stream, p->buf);
+        g_free(p);
+    }
+}
+
+/* Write the queued buffers of one stream into the ring, off the BQL. It
+ * stops when the ring is full, and the buffer stays in the queue for the
+ * next pass. It does not call virtqueue_push or virtio_notify: the
+ * buffers go on the pending list, and the main thread returns them once
+ * the reader has consumed their audio. */
+static void vsnd_writer_drain_stream(VirtIOSoundPCMStream *stream)
+{
+    WITH_QEMU_LOCK_GUARD(&stream->queue_mutex) {
+        while (!QSIMPLEQ_EMPTY(&stream->queue)) {
+            VirtIOSoundPCMBuffer *buffer = QSIMPLEQ_FIRST(&stream->queue);
+            if (!virtio_queue_ready(buffer->vq)) {
+                return;
+            }
+            if (!stream->active) {
+                /* Stream torn down between enqueue and now. Defer the
+                 * release to the main thread by punting through the
+                 * pending list with end_head=current; main thread sees
+                 * it immediately reapable. */
+                QSIMPLEQ_REMOVE(&stream->queue, buffer,
+                                VirtIOSoundPCMBuffer, entry);
+                vsnd_bypass_pending_push(stream, buffer,
+                                         vsnd_bypass_head_value());
+                continue;
+            }
+            if (!buffer->populated) {
+                iov_to_buf(buffer->elem->out_sg,
+                           buffer->elem->out_num,
+                           sizeof(virtio_snd_pcm_xfer),
+                           buffer->data,
+                           buffer->size);
+                buffer->populated = true;
+            }
+            if (vsnd_bypass_write_convert(buffer->data + buffer->offset,
+                                          buffer->size) == 0) {
+                /* The ring is full: leave the buffer in the queue and
+                 * retry on the next tick. */
+                return;
+            }
+            QSIMPLEQ_REMOVE(&stream->queue, buffer,
+                            VirtIOSoundPCMBuffer, entry);
+            vsnd_bypass_pending_push(stream, buffer,
+                                     vsnd_bypass_head_value());
+        }
+    }
+}
+
+/* The writer thread polls every 1 ms, with no BQL and no AioContext. On
+ * each tick, while the bypass is active, it writes each output stream into
+ * the ring. The cleanup path stops it by clearing vsnd_writer_run and
+ * joining the thread. */
+static void *vsnd_writer_thread_fn(void *arg)
+{
+    (void)arg;
+    vsnd_writer_thread_set_rt();
+    const struct timespec tick = { .tv_sec = 0, .tv_nsec = 1000000 };
+    while (atomic_load_explicit(&vsnd_writer_run, memory_order_acquire)) {
+        nanosleep(&tick, NULL);
+        if (!atomic_load_explicit(&vsnd_bypass_active, memory_order_acquire)) {
+            continue;
+        }
+        VirtIOSound *target = atomic_load_explicit(&vsnd_writer_target,
+                                                   memory_order_acquire);
+        if (!target) {
+            continue;
+        }
+        for (uint32_t i = 0; i < target->snd_conf.streams; i++) {
+            VirtIOSoundPCMStream *s = target->pcm.streams[i];
+            if (s && s->info.direction == VIRTIO_SND_D_OUTPUT) {
+                vsnd_writer_drain_stream(s);
+            }
+        }
+    }
+    return NULL;
+}
+
+static void vsnd_writer_thread_start(VirtIOSound *target)
+{
+    atomic_store_explicit(&vsnd_writer_target, target, memory_order_release);
+    if (vsnd_writer_started) {
+        return;
+    }
+    atomic_store_explicit(&vsnd_writer_run, 1, memory_order_release);
+    if (pthread_create(&vsnd_writer_thread, NULL,
+                       vsnd_writer_thread_fn, NULL) == 0) {
+        vsnd_writer_started = true;
+        fprintf(stderr,
+                "virtio-snd: bypass writer thread started\n");
+    } else {
+        atomic_store_explicit(&vsnd_writer_run, 0, memory_order_release);
+        fprintf(stderr,
+                "virtio-snd: warning: could not start the writer thread; "
+                "nothing will fill the bypass ring\n");
+    }
+}
+
+static void vsnd_writer_thread_stop(void)
+{
+    atomic_store_explicit(&vsnd_writer_target, NULL, memory_order_release);
+    if (!vsnd_writer_started) {
+        return;
+    }
+    atomic_store_explicit(&vsnd_writer_run, 0, memory_order_release);
+    pthread_join(vsnd_writer_thread, NULL);
+    vsnd_writer_started = false;
+}
+
+#define VSND_DRAIN_INTERVAL_MS 2
+static QEMUTimer *vsnd_drain_timer;
+
+/* Log xruns at most once per second. The drain timer (every 2 ms) calls
+ * this, and it prints a line only when the underrun or overrun count has
+ * changed since the last line. The underrun duration is computed from the
+ * HAL rate, at which the host callback plays. */
+static void vsnd_log_xruns_if_due(void)
+{
+    static int64_t last_log_ms;
+    static uint64_t last_underrun_frames;
+    static uint64_t last_overrun_count;
+
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    if (now - last_log_ms < 1000) {
+        return;
+    }
+    last_log_ms = now;
+
+    uint64_t uf = atomic_load_explicit(&vsnd_bypass_underrun_frames,
+                                       memory_order_relaxed);
+    uint64_t oc = atomic_load_explicit(&vsnd_bypass_overrun_count,
+                                       memory_order_relaxed);
+    uint64_t d_underrun = uf - last_underrun_frames;
+    uint64_t d_overrun = oc - last_overrun_count;
+    last_underrun_frames = uf;
+    last_overrun_count = oc;
+
+    if (d_underrun == 0 && d_overrun == 0) {
+        return;
+    }
+    unsigned rate = host_audio_active_samplerate();
+    if (rate == 0) rate = 96000;
+    uint64_t d_underrun_us = (d_underrun * 1000000ULL) / rate;
+    fprintf(stderr,
+            "virtio-snd: xrun report: underrun frames=%llu (~%llu us "
+            "of silence in the last second), overrun count=%llu (writes "
+            "deferred because the ring was full)\n",
+            (unsigned long long)d_underrun,
+            (unsigned long long)d_underrun_us,
+            (unsigned long long)d_overrun);
+}
+
+/* The drain timer runs on the QEMU main loop and does two jobs:
+ *   1. vsnd_bypass_pending_drain returns finished buffers to the guest
+ *      with virtqueue_push and virtio_notify, which need the BQL.
+ *   2. vsnd_log_xruns_if_due logs xruns at most once per second.
+ * The timer returns at once when the bypass is inactive, so the out_cb
+ * loop below runs only in bypass mode, where out_cb only drains the
+ * pending list again. */
+static void vsnd_drain_timer_cb(void *opaque)
+{
+    if (!atomic_load_explicit(&vsnd_bypass_active, memory_order_acquire))
+        return;
+
+    vsnd_bypass_pending_drain();
+
+    if (vsnd_drain_target_dev) {
+        for (uint32_t i = 0; i < vsnd_drain_target_dev->snd_conf.streams; i++) {
+            VirtIOSoundPCMStream *s = vsnd_drain_target_dev->pcm.streams[i];
+            if (s && s->info.direction == VIRTIO_SND_D_OUTPUT)
+                virtio_snd_pcm_out_cb(s, INT_MAX);
+        }
+    }
+
+    vsnd_log_xruns_if_due();
+
+    timer_mod(vsnd_drain_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + VSND_DRAIN_INTERVAL_MS);
+}
+
+/* Turn the bypass off because the host audio path changed: the default
+ * output device changed, or the output device is being torn down. The
+ * next out_cb takes the AUD_write path. coreaudio.m calls this from HAL
+ * listeners, which run off the BQL, so the body must not take a lock. */
+void virtio_snd_bypass_invalidate(const char *reason);
+void virtio_snd_bypass_invalidate(const char *reason)
+{
+    int prev = atomic_exchange_explicit(&vsnd_bypass_active, 0,
+                                        memory_order_acq_rel);
+    if (prev) {
+        fprintf(stderr,
+                "virtio-snd: the host audio bypass is off (%s); "
+                "using the mixer\n",
+                reason ? reason : "unknown");
+    }
+}
+
+/* Silence written to the ring on a cold activation, so the reader has
+ * data while the writer produces its first burst: the ring starts empty,
+ * the reader runs every 2-5 ms, and the writer needs a few ticks. The
+ * prefill is 16384 bytes, about 21 ms at 96 kHz stereo F32 and 12.5% of
+ * the ring. It plays as leading silence when the stream starts. */
+#define VSND_BYPASS_PREFILL_BYTES 16384
+
+static void virtio_snd_bypass_set_active(int on, int src_fmt, uint32_t guest_rate)
+{
+    if (on) {
+        /* Decide whether to reset the ring.
+         *
+         * Cold start: the format differs from the cached one (it is 0 at
+         * boot). The old ring contents do not fit the new stream, so the
+         * ring is cleared and prefilled with silence.
+         *
+         * Warm re-activation (same format) follows the guest's
+         * VIRTIO_SND_R_PCM_RELEASE and VIRTIO_SND_R_PCM_PREPARE during
+         * xrun recovery. The stream is continuous and the ring holds valid
+         * PCM, so the ring is kept; a reset would insert 46 ms of silence
+         * at 44.1 kHz. */
+        bool fmt_changed = (vsnd_bypass_src_fmt != src_fmt);
+        vsnd_bypass_src_fmt = src_fmt;
+        atomic_store_explicit(&vsnd_bypass_guest_rate, guest_rate,
+                              memory_order_relaxed);
+        if (fmt_changed) {
+            atomic_store_explicit(&vsnd_bypass_tail, 0, memory_order_relaxed);
+            /* Zero the prefill region first, because the static ring may
+             * hold data from a previous session. Then publish head after
+             * the zeros, so the reader never sees stale data. */
+            memset(vsnd_bypass_ring, 0, VSND_BYPASS_PREFILL_BYTES);
+            atomic_store_explicit(&vsnd_bypass_head,
+                                  VSND_BYPASS_PREFILL_BYTES,
+                                  memory_order_release);
+            /* Clear the resampler window, so the first output
+             * interpolates from silence. */
+            memset(&vsnd_resampler, 0, sizeof(vsnd_resampler));
+            /* Reset the PLL integrator: its correction belongs to the
+             * previous pair of clocks. */
+            vsnd_pll_integrator = 0.0;
+        }
+        if (!vsnd_drain_timer) {
+            vsnd_drain_timer = timer_new_ms(QEMU_CLOCK_REALTIME,
+                                             vsnd_drain_timer_cb, NULL);
+        }
+        timer_mod(vsnd_drain_timer,
+                  qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + VSND_DRAIN_INTERVAL_MS);
+        /* Start the writer thread, or point it at this device, now that
+         * the ring is published. */
+        if (vsnd_drain_target_dev) {
+            vsnd_writer_thread_start(vsnd_drain_target_dev);
+        }
+    } else {
+        /* Stop the writer thread before flushing the pending list, so no
+         * new entries arrive. */
+        vsnd_writer_thread_stop();
+        if (vsnd_drain_timer) {
+            timer_del(vsnd_drain_timer);
+        }
+        vsnd_bypass_pending_flush();
+    }
+    int prev = atomic_exchange_explicit(&vsnd_bypass_active, on,
+                                        memory_order_acq_rel);
+    if (prev != on) {
+        fprintf(stderr, "virtio-snd: host audio bypass %s (fmt=%d)\n",
+                on ? "on" : "off", src_fmt);
+    }
+}
