diff --git a/ui/shm-display.c b/ui/shm-display.c
new file mode 100644
index 0000000..e984c1a
--- /dev/null
+++ b/ui/shm-display.c
@@ -0,0 +1,293 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * QEMU shared-memory display backend  (-display shm,path=FILE)
+ *
+ * Maps the guest framebuffer into a regular file (MAP_SHARED) so an external
+ * process can mmap it and read pixel data with a single memcpy per dirty rect.
+ *
+ * Header layout (little-endian, offset in bytes):
+ *
+ *   [0]   u32  magic       0x514D5348  ("QMS\x00")
+ *   [4]   u32  generation  atomic; odd while an update is being written
+ *   [8]   u32  width
+ *   [12]  u32  height
+ *   [16]  u32  stride      bytes per row
+ *   [20]  u32  format      1 = RGBA8888 (QEMU converts XRGB to RGBA when it writes)
+ *   [24]  u32  dirty_x   \
+ *   [28]  u32  dirty_y    | bounding box of the last update
+ *   [32]  u32  dirty_w    |
+ *   [36]  u32  dirty_h   /
+ *   [40]  u8[] _pad       pad to offset 64
+ *   [64]  u8[] pixels     stride × height bytes
+ *
+ * `generation` is a sequence counter. Each update adds 1 before it writes
+ * the header or the pixels, which makes the counter odd, and adds 1 with
+ * release ordering when it is done, which makes it even again. A reader
+ * loads the counter with acquire ordering, skips an odd value, reads the
+ * header, and loads the counter again: an unchanged even value means that
+ * the header it read is consistent. A step of 2 is exactly one update.
+ *
+ * Usage:
+ *   -display shm,path=/tmp/cdj3k-0/main.shm
+ */
+
+#include "qemu/osdep.h"
+#include "ui/console.h"
+#include "qapi/error.h"
+#include "qapi/qapi-types-ui.h"
+#include "qemu/module.h"
+#include "qemu/error-report.h"
+
+#include <sys/mman.h>
+#include <fcntl.h>
+
+/* ------------------------------------------------------------------ */
+/* constants and types                                                  */
+/* ------------------------------------------------------------------ */
+
+#define SHM_MAGIC           UINT32_C(0x514D5348)  /* "QMS\x00" */
+#define SHM_PIXELS_OFFSET   UINT32_C(64)
+#define SHM_FORMAT_XRGB8888 UINT32_C(0)
+#define SHM_FORMAT_RGBA8888 UINT32_C(1)  /* R, G, B, A byte order; the reader needs no swap. */
+
+typedef struct ShmHdr {
+    uint32_t magic;
+    uint32_t generation;   /* the sequence counter; odd during an update */
+    uint32_t width;
+    uint32_t height;
+    uint32_t stride;       /* bytes per row */
+    uint32_t format;       /* SHM_FORMAT_* */
+    uint32_t dirty_x;
+    uint32_t dirty_y;
+    uint32_t dirty_w;
+    uint32_t dirty_h;
+    uint8_t  _pad[SHM_PIXELS_OFFSET - 40];
+} ShmHdr;
+
+typedef struct ShmDisplay {
+    DisplayChangeListener  dcl;
+    DisplaySurface        *surface;
+    char                  *path;
+    ShmHdr                *hdr;       /* MAP_SHARED base; NULL until first switch */
+    size_t                 map_size;
+} ShmDisplay;
+
+/* ------------------------------------------------------------------ */
+/* shm file management                                                  */
+/* ------------------------------------------------------------------ */
+
+static int shm_remap(ShmDisplay *s, uint32_t height, uint32_t stride)
+{
+    size_t sz = SHM_PIXELS_OFFSET + (size_t)stride * height;
+
+    if (s->hdr && s->map_size == sz)
+        return 0; /* already correct size */
+
+    if (s->hdr) {
+        munmap(s->hdr, s->map_size);
+        s->hdr = NULL;
+    }
+
+    /*
+     * Open without O_TRUNC, so the file never shrinks. A reader (the
+     * emulator) may hold a live MAP_SHARED mapping, and truncating the file
+     * to 0 would give it SIGBUS on its next access. Growing the file with
+     * ftruncate is safe: the new pages are zero-filled and the old mapping
+     * stays valid.
+     */
+    int fd = open(s->path, O_RDWR | O_CREAT, 0600);
+    if (fd < 0) {
+        error_report("shm-display: open '%s': %s", s->path, strerror(errno));
+        return -1;
+    }
+    struct stat st;
+    if (fstat(fd, &st) < 0 || (size_t)st.st_size < sz) {
+        if (ftruncate(fd, (off_t)sz) < 0) {
+            error_report("shm-display: ftruncate: %s", strerror(errno));
+            close(fd);
+            return -1;
+        }
+    }
+
+    void *m = mmap(NULL, sz, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (m == MAP_FAILED) {
+        error_report("shm-display: mmap: %s", strerror(errno));
+        return -1;
+    }
+
+    s->hdr      = (ShmHdr *)m;
+    s->map_size = sz;
+
+    /* The file outlives QEMU, so the counter may be odd if the previous
+     * QEMU stopped during an update. Make it even again. */
+    uint32_t gen = __atomic_load_n(&s->hdr->generation, __ATOMIC_RELAXED);
+    if (gen & 1u) {
+        __atomic_store_n(&s->hdr->generation, gen + 1u, __ATOMIC_RELEASE);
+    }
+    return 0;
+}
+
+/* Start an update: the counter becomes odd before any header or pixel
+ * store. */
+static void shm_write_begin(ShmHdr *hdr)
+{
+    __atomic_fetch_add(&hdr->generation, 1u, __ATOMIC_RELAXED);
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+}
+
+/* End an update: after this release add, the counter is even, and a reader
+ * that loads it with acquire ordering sees the header and the pixels. */
+static void shm_write_end(ShmHdr *hdr)
+{
+    __atomic_fetch_add(&hdr->generation, 1u, __ATOMIC_RELEASE);
+}
+
+/* ------------------------------------------------------------------ */
+/* DisplayChangeListener callbacks                                      */
+/* ------------------------------------------------------------------ */
+
+/* Copy a rect of the surface into the shm file and record it as the dirty
+ * rect. The caller brackets it with shm_write_begin and shm_write_end. */
+static void shm_blit(ShmDisplay *s, int x, int y, int w, int h)
+{
+    DisplaySurface *sur = s->surface;
+
+    int      bpp     = surface_bytes_per_pixel(sur);
+    int      sstride = surface_stride(sur);
+    uint8_t *src     = surface_data(sur)
+                       + (size_t)y * sstride + (size_t)x * bpp;
+    uint8_t *dst     = (uint8_t *)s->hdr + SHM_PIXELS_OFFSET
+                       + (size_t)y * s->hdr->stride + (size_t)x * bpp;
+
+    /* Convert XRGB8888 (B, G, R, X in memory) to RGBA8888 (R, G, B, A in
+     * memory). The loop uses whole u32 loads and shifts so that the compiler
+     * can vectorize it with NEON; it runs under the BQL.
+     *
+     * Per pixel, as a little-endian u32:
+     *   src = X<<24 | R<<16 | G<<8 | B          (memory order B,G,R,X)
+     *   dst = 0xFF<<24 | B<<16 | G<<8 | R       (memory order R,G,B,A)
+     */
+    for (int row = 0; row < h; row++, src += sstride, dst += s->hdr->stride) {
+        const uint32_t *s32 = (const uint32_t *)src;
+        uint32_t       *d32 = (uint32_t *)dst;
+        for (int col = 0; col < w; col++) {
+            uint32_t p = s32[col];
+            d32[col] = 0xFF000000u
+                     | ((p << 16) & 0x00FF0000u)   /* B to bits 16..23 */
+                     | (p & 0x0000FF00u)           /* G unchanged     */
+                     | ((p >> 16) & 0x000000FFu);  /* R to bits 0..7  */
+        }
+    }
+
+    s->hdr->dirty_x = (uint32_t)x;
+    s->hdr->dirty_y = (uint32_t)y;
+    s->hdr->dirty_w = (uint32_t)w;
+    s->hdr->dirty_h = (uint32_t)h;
+}
+
+static void shm_gfx_update(DisplayChangeListener *dcl,
+                            int x, int y, int w, int h)
+{
+    ShmDisplay *s = container_of(dcl, ShmDisplay, dcl);
+
+    if (!s->hdr || !s->surface || w <= 0 || h <= 0)
+        return;
+
+    shm_write_begin(s->hdr);
+    shm_blit(s, x, y, w, h);
+    shm_write_end(s->hdr);
+}
+
+static void shm_gfx_switch(DisplayChangeListener *dcl, DisplaySurface *surface)
+{
+    ShmDisplay *s = container_of(dcl, ShmDisplay, dcl);
+    s->surface = surface;
+
+    if (!surface)
+        return;
+
+    uint32_t w      = (uint32_t)surface_width(surface);
+    uint32_t h      = (uint32_t)surface_height(surface);
+    uint32_t stride = (uint32_t)surface_stride(surface);
+
+    if (shm_remap(s, h, stride) < 0)
+        return;
+
+    /* Write the header and the first full frame as one update, so the
+     * reader never sees a new size with old pixels. */
+    shm_write_begin(s->hdr);
+    s->hdr->magic  = SHM_MAGIC;
+    s->hdr->width  = w;
+    s->hdr->height = h;
+    s->hdr->stride = stride;
+    s->hdr->format = SHM_FORMAT_RGBA8888;
+    if (w > 0 && h > 0) {
+        shm_blit(s, 0, 0, (int)w, (int)h);
+    }
+    shm_write_end(s->hdr);
+}
+
+static void shm_refresh(DisplayChangeListener *dcl)
+{
+    graphic_hw_update(dcl->con);
+}
+
+static const DisplayChangeListenerOps shm_ops = {
+    .dpy_name       = "shm",
+    .dpy_gfx_update = shm_gfx_update,
+    .dpy_gfx_switch = shm_gfx_switch,
+    .dpy_refresh    = shm_refresh,
+};
+
+/* ------------------------------------------------------------------ */
+/* init and registration                                                */
+/* ------------------------------------------------------------------ */
+
+static void shm_display_init(DisplayState *ds, DisplayOptions *opts)
+{
+    DisplaySHM *o = &opts->u.shm;
+    ShmDisplay *s = g_new0(ShmDisplay, 1);
+
+    s->path    = g_strdup(o->path);
+    s->dcl.ops = &shm_ops;
+
+    /*
+     * Registering with dcl->con = NULL delivers a 640×480 placeholder
+     * surface and never routes the virtio-gpu console updates. Devices are
+     * initialised before qemu_display_init(), so attach to the first
+     * graphic console.
+     */
+    for (unsigned i = 0; ; i++) {
+        QemuConsole *con = qemu_console_lookup_by_index(i);
+        if (!con) {
+            break;
+        }
+        if (qemu_console_is_graphic(con)) {
+            s->dcl.con = con;
+            break;
+        }
+    }
+
+    if (!s->dcl.con) {
+        fprintf(stderr, "shm-display: there is no graphic console; "
+                        "the framebuffer will not be captured\n");
+    }
+
+    register_displaychangelistener(&s->dcl);
+    fprintf(stderr, "shm-display: sharing framebuffer at %s (console %d)\n",
+            s->path, qemu_console_get_index(s->dcl.con));
+}
+
+static QemuDisplay qemu_display_shm = {
+    .type = DISPLAY_TYPE_SHM,
+    .init = shm_display_init,
+};
+
+static void shm_display_register(void)
+{
+    qemu_display_register(&qemu_display_shm);
+}
+
+type_init(shm_display_register);
