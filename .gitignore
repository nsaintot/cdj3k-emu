Cargo.lock
# Compiled guest binaries (all outputs land in guest/out/)
guest/out/
# Build workspace (includes build/cache/)
build/
# macOS metadata
*.DS_Store
# Encryption keys
*.key
# Distribution output
dist/
# Rust build output
target/

# ignore python scripts
scripts/*.py

# QEMU: ignore the cloned src tree, build artefacts, and install dir.
# Track only build.sh, the overlay rsync'd onto src, and the shim sources.
qemu/*
!qemu/build.sh
!qemu/macos-deps.sh
!qemu/patches
!qemu/shim

# Assets: track only the OTF fonts; everything else (PNGs, PPM captures,
# Helvetica) is excluded from the repo (kept on disk locally for dev use).
app/cdj3k-emu/assets/*
!app/cdj3k-emu/assets/preview.png
!app/cdj3k-emu/assets/icon*
!app/cdj3k-emu/assets/*.icns
!app/cdj3k-emu/assets/*.otf

# Apple provisioning profile authorising the restricted entitlements
# (vmnet, virtual HID).  Team-specific; supply your own via --profile.
*.provisionprofile

# winit fetched and patched by winit/fetch.sh
winit/src/
# Linux QEMU artefacts copied out of the docker build
qemu-linux-arm64/
# cdj3k-mods checkout (its own repository)
guest/ep122_shim/cdj3k-mods/
